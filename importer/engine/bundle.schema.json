{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KGHQ Lovable conversion bundle v1",
  "type": "object",
  "required": ["schemaVersion", "repository", "pages", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["route", "title", "scope", "content", "css"],
        "properties": {
          "route": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9/_-]*$" },
          "title": { "type": "string" },
          "scope": { "type": "string", "pattern": "^kghq-page-[a-f0-9]{12}$" },
          "content": { "type": "string", "maxLength": 2097152 },
          "css": { "type": "string", "maxLength": 3145728 },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "typography": { "type": "object" }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "filename", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "filename": { "type": "string" },
          "mime": { "type": "string" },
          "data": { "type": "string", "contentEncoding": "base64" }
        }
      }
    },
    "scan": { "type": "object" }
  }
}
