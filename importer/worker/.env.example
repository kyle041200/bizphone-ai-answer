# Configure outside the repository; never commit actual credentials.
KGHQ_WORKER_TOKEN=replace-with-at-least-32-random-characters
KGHQ_ALLOWED_REPOSITORIES=your-owner/your-lovable-project
KGHQ_WORKER_DATA=/srv/kghq-worker-data
KGHQ_WORKER_HOST=127.0.0.1
PORT=8787
KGHQ_RUNNER_IMAGE=kghq-converter-runner:0.4.0
KGHQ_INSTALL_NETWORK=bridge
# Optional read-only fine-grained GitHub token. Never passed into build containers.
# KGHQ_GITHUB_TOKEN=
# Optional unauthenticated egress proxy and public CA for dependency installation:
# KGHQ_NPM_PROXY=
# KGHQ_NPM_CA=
