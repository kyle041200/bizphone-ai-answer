# Example only. Supply your actual hostname, certificate, and access policy.
server {
    listen 443 ssl;
    server_name converter.example.test;
    ssl_certificate /etc/ssl/kghq/fullchain.pem;
    ssl_certificate_key /etc/ssl/kghq/privkey.pem;
    client_max_body_size 64k;
    location /v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
        proxy_redirect off;
    }
}
